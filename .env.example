# Required in every deployed environment.
# Payload accepts DATABASE_URI as its canonical name. DATABASE_URL and
# POSTGRES_URL from Vercel Marketplace integrations are also detected.
DATABASE_URI=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional: force the local SQLite CMS while running a production-mode server.
PAYLOAD_LOCAL=false

# Required in production for persistent media uploads on Vercel.
BLOB_READ_WRITE_TOKEN=

# DingTalk passwordless login for authorized website operators.
CMS_DINGTALK_APP_KEY=
CMS_DINGTALK_APP_SECRET=
CMS_DINGTALK_CORP_ID=
CMS_DINGTALK_PUBLISHER_ROLE=官网运营
